<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- CorrelationId comes from the logging scope opened by CorrelationIdMiddleware -->
  <variable name="layout"
            value="${longdate}|${level:uppercase=true}|${scopeproperty:CorrelationId:whenEmpty=-}|${logger}|${message}${onexception:inner= | ${exception:format=type,message}}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${layout}" />
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/levbakehila-${shortdate}.log"
            layout="${layout}"
            maxArchiveDays="14" />
  </targets>

  <rules>
    <!-- Startup / shutdown lines ("Now listening on ...") - shown in the console, which Render collects from stdout -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />

    <!-- Skip noisy framework logs below Warning -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Debug" writeTo="console,file" />
  </rules>
</nlog>
